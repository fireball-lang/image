mod image;

import image::{Image, Pixel, Format};

import std::c::{malloc, free};
import std::os::{File};

/// An image that owns its data.
pub struct DynamicImage {
    data: mut []u8,
    format: Format,

    width: u32,
    height: u32,
    stride: u32,
}

impl DynamicImage {
    pub func new(width: u32, height: u32, format: Format) Self {
        var size = width * height * format.size();

        return Self {
            data: MutSlice:[u8] {
                ptr: malloc(size) as mut *u8,
                size: width * height * format.size(),
            },
            format: format,
            width: width,
            height: height,
            stride: width * format.size(),
        };
    }

    pub func read_from(path: StringView) ?Self {
        var i = path.index_of_last(".");
        if (i == -1) return Option:[Self]::none();

        var file = File::open(path)?;
        var ext = path.slice(i as u32 + 1, path.size);

        var img: ?Self;

        if (ext == "bmp") img = image::bmp::read(&file);
        else if (ext == "qoi") img = image::qoi::read(&file);

        file.close();
        return img;
    }

    pub func width(self) u32 {
        return self.width;
    }

    pub func height(self) u32 {
        return self.height;
    }

    pub func stride(self) u32 {
        return self.stride;
    }

    pub func format(self) Format {
        return self.format;
    }

    pub func data(self) []u8 {
        return self.data;
    }

    pub func mut_data(self) mut []u8 {
        return self.data;
    }

    pub func free(mut self) {
        free(self.data.ptr);
        self.data = MutSlice:[u8] {};
    }

    /// Consumes the dynamic image and returns a typed Image[T].
    /// If the format matches, it reuses the buffer (zero copy).
    /// If the format differs, it converts all pixels and frees the old buffer.
    pub func into_typed[T: Pixel](mut self) Image[T] {
        var target_format = T::format();

        // Fast path: format already matches
        if (self.format == target_format) {
            return Image:[T] {
                pixels: MutSlice:[T] {
                    ptr: self.data.ptr as mut *T,
                    size: (self.width * self.height) as u64,
                },
                width: self.width,
                height: self.height,
                stride: self.stride,
            };
        }

        // Slow path: allocate new typed image and convert pixels
        var out = Image:[T]::new(self.width, self.height);

        var total_pixels = self.width * self.height;
        var src = self.data.ptr;
        var dst = out.mut_pixels().ptr as mut *u8;

        var src_bytes = self.format.size();
        var dst_bytes = target_format.size();

        var src_idx = 0u;
        var dst_idx = 0u;

        var src_format = self.format;

        for (var i = 0u; i < total_pixels; i++) {
            var r: u8 = 0;
            var g: u8 = 0;
            var b: u8 = 0;
            var a: u8 = 255;

            // Read Source Pixel
            if (src_format == Format::R8) {
                r = src[src_idx];
                g = r;
                b = r;
            } else if (src_format == Format::RG8) {
                r = src[src_idx + 0];
                g = src[src_idx + 1];
            } else if (src_format == Format::RGB8) {
                r = src[src_idx + 0];
                g = src[src_idx + 1];
                b = src[src_idx + 2];
            } else if (src_format == Format::RGBA8) {
                r = src[src_idx + 0];
                g = src[src_idx + 1];
                b = src[src_idx + 2];
                a = src[src_idx + 3];
            }

            // Write Target Pixel
            if (target_format == Format::R8) {
                // Perceptual grayscale formula: 0.299 R + 0.587 G + 0.114 B
                var luma = ((r as u32) * 299 + (g as u32) * 587 + (b as u32) * 114) / 1000;
                dst[dst_idx] = luma as u8;
            } else if (target_format == Format::RG8) {
                dst[dst_idx + 0] = r;
                dst[dst_idx + 1] = g;
            } else if (target_format == Format::RGB8) {
                dst[dst_idx + 0] = r;
                dst[dst_idx + 1] = g;
                dst[dst_idx + 2] = b;
            } else if (target_format == Format::RGBA8) {
                dst[dst_idx + 0] = r;
                dst[dst_idx + 1] = g;
                dst[dst_idx + 2] = b;
                dst[dst_idx + 3] = a;
            }

            src_idx += src_bytes;
            dst_idx += dst_bytes;
        }

        // Free the old DynamicImage memory
        self.free();

        return out;
    }
}
